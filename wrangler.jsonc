{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiguang-study-api",
  "main": "cloud/index.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://niko-kang.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiguang-study-records",
      "migrations_dir": "cloud/migrations",
      "database_id": "b371190a-9220-4bd9-8155-49f54f07f31e"
    }
  ],
  "account_id": "e542953ac7f8f3cf2dd479a69b323246"
}
